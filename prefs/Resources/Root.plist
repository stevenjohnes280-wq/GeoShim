<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>GeoShim</string>
	<key>items</key>
	<array>

		<!-- Live status. The rows refresh on appear, on the prefsChanged
		     notification, and on a 2 s poll (see GeoShimRootListController), so
		     the locationd line tracks spoofing changes instead of getting stuck.
		     The footer is the disclaimer: this only covers the public API. -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Status</string>
			<key>footerText</key>
			<string>This value is only served via the public CoreLocation API. Apps that read location through a private, first-party path (for example Apple Maps) are not affected.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>id</key>
			<string>statusState</string>
			<key>label</key>
			<string>State</string>
			<key>get</key>
			<string>statusState:</string>
			<key>enabled</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>id</key>
			<string>statusCoordinate</string>
			<key>label</key>
			<string>Coordinate</string>
			<key>get</key>
			<string>statusCoordinate:</string>
			<key>enabled</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>id</key>
			<string>statusLocationd</string>
			<key>label</key>
			<string>locationd</string>
			<key>get</key>
			<string>statusLocationd:</string>
			<key>enabled</key>
			<false/>
		</dict>

		<!-- Spoofing master switch. Writes Enabled to the domain and posts the
		     reload notification, so locationd applies it live (same as
		     `geoshim start`/`stop`). -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Spoofing</string>
			<key>footerText</key>
			<string>Master switch. `geoshim start` and `geoshim stop` set this too.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>defaults</key>
			<string>xyz.regulad.geoshim</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>xyz.regulad.geoshim/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Set location on map…</string>
			<key>action</key>
			<string>openMap</string>
		</dict>

		<!-- App-side fallback: the master toggle plus the AltList picker. The
		     fallback is normally ON for every app; the picker is an exclusion
		     list. AltList stores the bundles whose switch differs from the
		     default, so with defaultApplicationSwitchValue = true the saved
		     DisabledBundles array is exactly the apps switched OFF. -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>App-side fallback</string>
			<key>footerText</key>
			<string>The in-process fallback is on for every app by default (it adds a synthetic update timer for apps that permit tweak injection; locationd already spoofs every app system-wide). Switch an app OFF here to exclude it. Changes apply on the app's next launch.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>App-side fallback</string>
			<key>defaults</key>
			<string>xyz.regulad.geoshim</string>
			<key>key</key>
			<string>AppFallback</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>xyz.regulad.geoshim/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>detail</key>
			<string>ATLApplicationListMultiSelectionController</string>
			<key>label</key>
			<string>Apps</string>
			<key>defaults</key>
			<string>xyz.regulad.geoshim</string>
			<key>key</key>
			<string>DisabledBundles</string>
			<key>defaultApplicationSwitchValue</key>
			<true/>
			<key>useSearchBar</key>
			<true/>
			<key>showIdentifiersAsSubtitle</key>
			<true/>
			<key>sections</key>
			<array>
				<dict>
					<key>sectionType</key>
					<string>User</string>
				</dict>
				<dict>
					<key>sectionType</key>
					<string>System</string>
				</dict>
			</array>
		</dict>

	</array>
</dict>
</plist>
