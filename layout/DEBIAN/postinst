#!/bin/sh
# Reload Settings so the PreferenceLoader entry appears without a manual respring.
# locationd is already restarted by the package's INSTALL_TARGET_PROCESSES, which
# reloads the daemon hook. The app-side fallback self-gates at each app's next
# launch, so no respring is needed for it either. We deliberately do NOT killall
# SpringBoard here - that could take down the package manager doing the install.
if [ "$1" = "configure" ] || [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
    killall Preferences >/dev/null 2>&1 || true
fi

exit 0
