<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>GeoShim</string>
	<key>items</key>
	<array>

		<!-- Live status, read from locationd (not the plist) so it can't lie.
		     Hook State and Spoofing State come from a daemon ping; all three rows
		     refresh on appear, on the prefsChanged notification, and on a 2 s poll
		     (see GeoShimRootListController). The footer is the disclaimer: this
		     only covers the public API. -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Status</string>
			<key>footerText</key>
			<string>The spoofed location is only served via the public CoreLocation API. Apps that read location through a private, first-party path (for example Apple Maps) are not affected.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>id</key>
			<string>statusHook</string>
			<key>label</key>
			<string>Hook State</string>
			<key>get</key>
			<string>statusHook:</string>
			<key>enabled</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>id</key>
			<string>statusSpoofing</string>
			<key>label</key>
			<string>Spoofing State</string>
			<key>get</key>
			<string>statusSpoofing:</string>
			<key>enabled</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>id</key>
			<string>statusCoordinate</string>
			<key>label</key>
			<string>Coordinate</string>
			<key>get</key>
			<string>statusCoordinate:</string>
			<key>enabled</key>
			<false/>
		</dict>

		<!-- The only toggle: spoofing on/off. Writes Enabled to the domain and
		     posts the reload notification, so locationd applies it live and
		     bounces itself (same as `geoshim start`/`stop`). The controller
		     reloads this switch on that notification so a CLI change can't leave
		     it stale. There is deliberately no GUI toggle for the app-side hook. -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Spoofing</string>
			<key>footerText</key>
			<string>Master switch. `geoshim start` and `geoshim stop` set this too.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>id</key>
			<string>enabledSwitch</string>
			<key>label</key>
			<string>Enabled</string>
			<key>get</key>
			<string>getEnabled:</string>
			<key>set</key>
			<string>setEnabled:specifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Set location on map…</string>
			<key>action</key>
			<string>openMap</string>
		</dict>

		<!-- Per-app exclusion for the app-side fallback. The fallback is on for
		     every app by default (there is no GUI toggle for it - manage that with
		     `geoshim fallback on|off`); this picker only chooses apps to leave
		     out. AltList stores the bundles whose switch differs from the default,
		     so with defaultApplicationSwitchValue = true the saved DisabledBundles
		     array is exactly the apps switched OFF. -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>App-side fallback</string>
			<key>footerText</key>
			<string>The in-process fallback is on for every app by default (it adds a synthetic update timer for apps that permit tweak injection; locationd already spoofs every app system-wide). Switch an app OFF here to exclude it. Changes apply on the app's next launch.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>detail</key>
			<string>ATLApplicationListMultiSelectionController</string>
			<key>label</key>
			<string>Apps</string>
			<key>defaults</key>
			<string>xyz.regulad.geoshim</string>
			<key>key</key>
			<string>DisabledBundles</string>
			<key>defaultApplicationSwitchValue</key>
			<true/>
			<key>useSearchBar</key>
			<true/>
			<key>showIdentifiersAsSubtitle</key>
			<true/>
			<key>sections</key>
			<array>
				<dict>
					<key>sectionType</key>
					<string>User</string>
				</dict>
				<dict>
					<key>sectionType</key>
					<string>System</string>
				</dict>
			</array>
		</dict>

	</array>
</dict>
</plist>
